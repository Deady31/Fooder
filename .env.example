# Mesure d'audience (PostHog, région UE). Inactif tant que la clé est vide.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Backend comptes et fil social (Supabase, région UE)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vraies photos des restaurants (Google Places API New, côté serveur uniquement, jamais NEXT_PUBLIC_)
GOOGLE_PLACES_API_KEY=
# Plafond de recherches de photos par jour et par instance (garde-fou de dépense)
GOOGLE_PHOTOS_DAILY_CAP=1500
